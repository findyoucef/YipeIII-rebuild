+        for (var column = 0; column < source.Width * scale; column++)
+        {
+            var x = left + column;
+            if (x < 0 || x >= IceWidth) continue;
+            var sx = source.X + (facingLeft ? source.Width - 1 - column / scale : column / scale);
+            for (var row = 0; row < height + lift * scale; row++)
