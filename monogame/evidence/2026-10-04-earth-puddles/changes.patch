+            109 => [(new(7, 5), new(32, 25)), (new(7, 1), new(34, 23))],
+            115 => [(new(4, 8), new(35, 24)), (new(8, 2), new(32, 21))],
+            _ => [],
+        };
+        foreach (var (cell, radius) in pools)
