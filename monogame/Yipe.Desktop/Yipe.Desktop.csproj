<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeFrameworkVersion Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">10.0.8</RuntimeFrameworkVersion>
  </PropertyGroup>
  <Import Project="../GameContent.props" />
  <ItemGroup>
    <EmbeddedResource Include="Icon.bmp" LogicalName="Icon.bmp" />
    <ProjectReference Include="../Yipe.Core/Yipe.Core.csproj" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <Content Include="@(GameContent)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
